# CityLab Diagnostics Environment Configuration

# Storage paths
DATA_DIR=data
CORPUS_DIR=corpus

# Controlled hackathon evaluation mode (enables sample patient persona tokens)
DEMO_MODE=true

# Public demo banner mode ("false" for standalone local launcher; Docker Compose sets "true")
PUBLIC_DEMO_MODE=false

# Optional JSON object mapping 32+ character bearer tokens to patient IDs
# Example: AUTH_TOKENS={"replace-with-32-plus-char-patient-token":"patient-p001"}
AUTH_TOKENS={}

# Optional Grounded LLM Explanation Provider ("disabled", "groq", or "openrouter")
# Note: OpenRouter models must be explicitly free-tier (ending with ":free").
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=

# Host & port for local launcher (Docker internal container port remains 8000)
HOST=127.0.0.1
PORT=8001
VITE_API_PROXY_TARGET=http://127.0.0.1:8001

# Allowed frontend origins for CORS
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8001,http://localhost:8001,http://127.0.0.1:8080,http://localhost:8080
